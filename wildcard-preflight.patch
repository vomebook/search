diff --git tests/test_wildcard_index_oracle.py tests/test_wildcard_index_oracle.py
new file mode 100644
index 0000000..7db6c36
--- /dev/null
+++ tests/test_wildcard_index_oracle.py
@@ -0,0 +1,141 @@
+"""Independent no-network oracle for the wildcard n-gram acceleration."""
+import gzip
+import json
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+
+from backend.data_formats import decode_search_payload
+from backend.search_indexes import load_ngram_index, resolve_postings
+from backend.search_words import records_digest
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class WildcardIndexOracleTests(unittest.TestCase):
+    def assert_index_matches(self, records, width, path):
+        """Compare the complete loaded index with an independently built mapping."""
+        from array import array
+
+        expected = {}
+        for idx, record in enumerate(records):
+            grams = set()
+            for field in ('_file_lower', '_repo_lower', '_folder_path_lower'):
+                text = record[field]
+                grams.update(text[i:i + width] for i in range(len(text) - width + 1))
+            for gram in grams:
+                expected.setdefault(gram, array('I')).append(idx)
+        entries, buffer = load_ngram_index(path, width, len(records), records_digest(records))
+        self.assertEqual(set(expected), set(entries))
+        for gram, indices in expected.items():
+            self.assertEqual(resolve_postings(entries[gram], buffer), set(indices), (width, gram))
+
+    def test_generated_index_is_exact_for_metadata_fields(self):
+        """Every width-2 and width-3 record posting must equal an independent scan."""
+        with gzip.open(ROOT / 'data/search_data.json.gz', 'rt', encoding='utf-8') as stream:
+            records = decode_search_payload(json.load(stream))
+        for record in records:
+            record['_file_lower'] = record.get('File', '').lower()
+            record['_repo_lower'] = record.get('Repo', '').lower()
+            record['_folder_path_lower'] = '/'.join(part.lower() for part in record.get('Folder', []))
+        for width in (2, 3):
+            with self.subTest(width=width):
+                self.assert_index_matches(records, width, ROOT / f'data/search_ngrams_{width}.bin.gz')
+
+    def test_semantically_changed_but_well_formed_indexes_fail_the_oracle(self):
+        """A valid digest and posting lengths must not hide missing or wrong IDs."""
+        records = [dict(_file_lower='中文', _repo_lower='', _folder_path_lower=''),
+                   dict(_file_lower='其他', _repo_lower='', _folder_path_lower='')]
+
+        def varint(value):
+            encoded = bytearray()
+            while value >= 128:
+                encoded.append((value & 127) | 128)
+                value >>= 7
+            encoded.append(value)
+            return bytes(encoded)
+
+        def write_index(path, entries, digest):
+            body = bytearray(b'VNG3\x02' + digest + varint(len(records)) + varint(len(entries)))
+            for gram, ids in entries.items():
+                key = gram.encode('utf-8')
+                previous = 0
+                deltas = bytearray()
+                for idx in ids:
+                    deltas.extend(varint(idx - previous))
+                    previous = idx
+                body.extend(varint(len(key)) + key + varint(len(ids)) + varint(len(deltas)) + deltas)
+            path.write_bytes(gzip.compress(body))
+
+        digest = records_digest(records)
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'index.gz'
+            correct = {'中文': [0], '其他': [1]}
+            write_index(path, correct, digest)
+            self.assert_index_matches(records, 2, path)
+            for changed in ({'中文': [0]}, {'中文': [1], '其他': [1]},
+                            {'中文': [0], '其他': [1], '额外': [0]}):
+                with self.subTest(entries=changed):
+                    write_index(path, changed, digest)
+                    self.assertTrue(load_ngram_index(path, 2, len(records), digest)[0],
+                                    'fixture must pass structural loading')
+                    with self.assertRaises(AssertionError):
+                        self.assert_index_matches(records, 2, path)
+            write_index(path, correct, b'X' * 32)
+            with self.assertRaises(AssertionError):
+                self.assert_index_matches(records, 2, path)
+            path.write_bytes(b'not a gzip file')
+            with self.assertRaises(AssertionError):
+                self.assert_index_matches(records, 2, path)
+            path.unlink()
+            with self.assertRaises(AssertionError):
+                self.assert_index_matches(records, 2, path)
+
+    def test_unicode_engine_has_no_equivalents_for_accelerated_ranges(self):
+        # Document the security-sensitive assumption behind the narrow ranges.
+        # The project runtime is CPython; non-CPython runtimes must not silently
+        # omit this oracle when evaluating whether to ship an optimization.
+        import _sre
+        from re._casefix import _EXTRA_CASES
+
+        def safe(codepoint):
+            return (0x3400 <= codepoint <= 0x4dbf or 0x4e00 <= codepoint <= 0x9fff
+                    or 0x30 <= codepoint <= 0x39)
+        collisions = [(value, _sre.unicode_tolower(value)) for value in range(0x110000)
+                      if safe(_sre.unicode_tolower(value)) and _sre.unicode_tolower(value) != value]
+        casefix = [(value, others) for value, others in _EXTRA_CASES.items()
+                   if safe(value) or any(safe(other) for other in others)]
+        self.assertEqual(collisions, [])
+        self.assertEqual(casefix, [])
+
+    def test_actual_index_preserves_selected_search_filters_and_page_anchors(self):
+        """Exercise the app's normal response with and without wildcard preselection."""
+        # Child process owns all startup globals and caches, so this expensive
+        # oracle remains safe even when invoked as part of another test suite.
+        script = '''
+from unittest.mock import patch
+from backend import app
+app.load_data()
+for query in ("马克*主义", "中国*文化", "1989*文"):
+    for folders in (True, False):
+        for page in (1, 2):
+            options = dict(q=query, exact=True, search_folders=folders, sort="name", page=page,
+                           extensions=["pdf"], page_size=3, anchor_id="VoiceOfML/Missing\\0not-present.pdf")
+            app._search_cache.clear(); app._search_order_cache.clear(); app._search_anchor_cache.clear()
+            actual = app.search(**options)
+            app._search_cache.clear(); app._search_order_cache.clear(); app._search_anchor_cache.clear()
+            with patch.object(app, "_wildcard_literal_candidates",
+                              side_effect=lambda _query, repos, _index, scope: sorted(scope(repos))):
+                baseline = app.search(**options)
+            assert actual == baseline, (query, folders, page)
+'''
+        result = subprocess.run([sys.executable, '-B', '-c', script], cwd=ROOT,
+                                capture_output=True, text=True, timeout=120, check=False)
+        self.assertEqual(result.returncode, 0, result.stderr)
+
+
+if __name__ == '__main__':
+    unittest.main()
