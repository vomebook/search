@@ -8,0 +9,58 @@ class SearchCandidatesMutationContractTests(unittest.TestCase):
+    def test_wildcard_safe_runs_select_longest_and_sort_owned_postings(self):
+        seen = []
+        scope = ["B", "A"]
+        postings = {7, 1, 3}
+        def candidates(query, repos):
+            seen.append((query, repos))
+            return postings
+        def fallback(_repos):
+            self.fail("usable index must not prepare the full scope")
+        result = wildcard_literal_candidates("中国*20261103?文化", scope, candidates, fallback)
+        self.assertEqual(result, [1, 3, 7])
+        self.assertEqual(seen, [("20261103", scope)])
+        self.assertEqual(postings, {7, 1, 3})
+
+    def test_wildcard_missing_index_and_short_or_unsafe_runs_use_sorted_scope(self):
+        seen = []
+        def candidates(query, repos):
+            seen.append((query, repos))
+            return None
+        def fallback(repos):
+            seen.append(("scope", repos))
+            return [5, 1, 9]
+        scope = ["A"]
+        self.assertEqual(wildcard_literal_candidates("中国*文化", scope, candidates, fallback), [1, 5, 9])
+        self.assertEqual(seen, [("中国", scope), ("scope", scope)])
+        for query in ("a*İ", "马?文", "**", "１２?K"):
+            seen.clear()
+            self.assertEqual(wildcard_literal_candidates(query, scope, candidates, fallback), [1, 5, 9])
+            self.assertEqual(seen, [("scope", scope)])
+
+    def test_wildcard_empty_posting_is_not_a_missing_index(self):
+        def candidates(query, repos):
+            self.assertEqual((query, repos), ("中文", None))
+            return set()
+        def fallback(_repos):
+            self.fail("an empty posting is authoritative")
+        self.assertEqual(wildcard_literal_candidates("中文*", None, candidates, fallback), [])
+
+    def test_wildcard_ideograph_boundaries_and_ascii_digits_are_safe_runs(self):
+        seen = []
+        def candidates(query, _repos):
+            seen.append(query)
+            return {0}
+        for query, expected in (("㐀䶿*", "㐀䶿"), ("一鿿*", "一鿿"),
+                                ("00*", "00"), ("㏿鿿*", None), ("龠가*", None)):
+            seen.clear()
+            self.assertEqual(wildcard_literal_candidates(query, None, candidates, lambda _: [1]),
+                             [0] if expected else [1])
+            self.assertEqual(seen, [expected] if expected else [])
+
+    def test_wildcard_dependency_failures_are_not_silently_hidden(self):
+        def failing(_query, _repos):
+            raise ValueError("index failure")
+        with self.assertRaisesRegex(ValueError, "index failure"):
+            wildcard_literal_candidates("中文*", None, failing, lambda _: [])
+        with self.assertRaisesRegex(ValueError, "scope failure"):
+            wildcard_literal_candidates("a*", None, failing, lambda _: (_ for _ in ()).throw(ValueError("scope failure")))
+
