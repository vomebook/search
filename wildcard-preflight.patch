diff --git backend/search_candidates.py backend/search_candidates.py
index 4ec7f41..09ed11b 100644
--- backend/search_candidates.py
+++ backend/search_candidates.py
@@ -4,0 +5 @@ from collections.abc import Callable, Iterable, Mapping, Sequence
+import re
@@ -9,0 +11,14 @@ PostingResolver = Callable[[Posting, bytes], set[int]]
+def wildcard_literal_candidates(query: str, repos: Iterable[str] | None,
+                                get_candidates: Callable[[str, Iterable[str] | None], set[int] | None],
+                                get_scope: Callable[[Iterable[str] | None], Sequence[int]]) -> list[int]:
+    """Bound wildcard search by a safe, mandatory CJK or ASCII-digit run.
+
+    These codepoints have no alternative Python IGNORECASE equivalents, unlike
+    ASCII letters and several other Unicode characters. The n-gram index covers
+    the same lowercased fields; the wildcard matcher still verifies each hit.
+    """
+    chunks = re.findall(r"[\u3400-\u4DBF\u4E00-\u9FFF0-9]{2,}", query)
+    candidates = get_candidates(max(chunks, key=len), repos) if chunks else None
+    return sorted(get_scope(repos) if candidates is None else candidates)
+
+
