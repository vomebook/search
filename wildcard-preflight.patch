diff --git tests/test_exact_search_performance.py tests/test_exact_search_performance.py
index 0f5ff3d..05e09bd 100644
--- tests/test_exact_search_performance.py
+++ tests/test_exact_search_performance.py
@@ -68,0 +69,36 @@ class ExactSearchCandidateTests(unittest.TestCase):
+    def test_indexed_wildcards_preserve_results_and_skip_unrelated_records(self):
+        # Build an independent, complete synthetic index over the same three
+        # lowercased fields. Do not rely on the production index generator.
+        grams = {2: {}, 3: {}}
+        for idx, rec in enumerate(app.records):
+            for text in (rec['_file_lower'], rec['_repo_lower'], rec['_folder_path_lower']):
+                for width in grams:
+                    for offset in range(len(text) - width + 1):
+                        grams[width].setdefault(text[offset:offset + width], set()).add(idx)
+        app.ngram_postings, app.ngram_posting_buffers = grams, {}
+        for query in ('马克*', '马克?思', '马克*思 文化', '伊斯?马克', '１２*', 'İ*', '*'):
+            for repos in (None, ['VoiceOfML/A'], ['VoiceOfML/B', 'VoiceOfML/A']):
+                for search_folders in (True, False):
+                    with self.subTest(query=query, repos=repos, folders=search_folders):
+                        expected = self.reference(query, repos, search_folders)
+                        self.assertEqual(app._search_order_uncached(q=query, exact=True, repos=repos,
+                                                                   search_folders=search_folders), expected)
+        first = sorted(app.literal_candidates('马克'))
+        original = app.compile_exact_matcher
+        calls = []
+        def counted(term):
+            matcher = original(term)
+            def invoke(text):
+                calls.append(text)
+                return matcher(text)
+            return invoke
+        with mock.patch.object(app, 'compile_exact_matcher', side_effect=counted):
+            app._search_order_uncached(q='马克*', exact=True)
+        self.assertLessEqual(len(calls), 3 * len(first))
+        self.assertLess(len(first), len(app.records))
+
+    def test_wildcard_optimization_never_replaces_empty_index_with_full_scope(self):
+        app.ngram_postings = {2: {'中文': {0}}}
+        with mock.patch.object(app, 'get_initial_indices', side_effect=AssertionError('unnecessary full scan')):
+            self.assertEqual(app._search_order_uncached(q='缺失*', exact=True), [])
+
