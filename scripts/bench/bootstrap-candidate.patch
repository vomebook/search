index 0000000..ac5a8be
--- /dev/null
+++ b/backend/search_bootstrap.py
@@ -0,0 +1,31 @@
+"""Typed construction of initial search pages from caller-owned state."""
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping, Sequence
+
+SearchRecord = dict[str, object]
+
+
+def trim_initial_results(raw: Iterable[SearchRecord]) -> list[SearchRecord]:
+    return [{"Repo": record.get("Repo", ""), "File": record.get("File", ""),
+             "Extension": record.get("Extension", ""), "Folder": record.get("Folder", []),
+             "Size": record.get("Size", ""), "HasTxt": record.get("HasTxt", "")} for record in raw]
+
+
+def build_initial_payload(repo: str | None, get_page_size: Callable[[], int],
+                          get_repos: Callable[[], Mapping[str, Sequence[int]]],
+                          get_records: Callable[[], Sequence[SearchRecord]],
+                          get_trim: Callable[[], Callable[[Sequence[SearchRecord]], list[SearchRecord]]],
+                          get_generation: Callable[[], Callable[[], str]]) -> dict[str, object]:
+    """Preserve snapshot lookup, projection and generation evaluation order."""
+    if repo:
+        indices = get_repos().get(repo, [])
+        result_records = [get_records()[index] for index in indices[:get_page_size()]]
+        mode = "repo"
+        total = len(indices)
+    else:
+        result_records = get_records()[:get_page_size()]
+        mode = "global"
+        total = len(get_records())
+    return {"mode": mode, "repo": repo, "sort": "relevance", "page": 1, "page_size": get_page_size(),
+            "total": total, "results": get_trim()(result_records), "generation": get_generation()()}
