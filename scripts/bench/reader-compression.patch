diff --git a/backend/reader_cache_policy.py b/backend/reader_cache_policy.py
new file mode 100644
index 0000000..bcbc74e
--- /dev/null
+++ b/backend/reader_cache_policy.py
@@ -0,0 +1,33 @@
+"""Classify synthetic or validated Reader paths for storage and cache policy."""
+import re
+
+
+def is_reader_bucket_cacheable(path: str) -> bool:
+    return (
+        path.endswith("/page-manifest.json") or path.endswith("/ocr-manifest.json")
+        or path.endswith('/reading-manifest.json') or path.endswith('/page-map.json.gz')
+        or path.endswith("/ocr/book-text.json.gz") or path.endswith("/pages/page-000001.webp")
+        or (path.startswith("objects/") and path.rsplit("/", 1)[-1].startswith("document."))
+        or (path.startswith("chapters/ebook/") and any(
+            path.endswith(suffix) for suffix in (
+                "/chapter-manifest.json", "/epub-search-index.json.gz",
+            )))
+    )
+
+
+def reader_bucket_cache_control(path: str) -> str:
+    if re.search(r"/pages/page-[0-9]{6}\.(?:webp|jxl|png)$", path):
+        return "public, max-age=31536000, immutable"
+    if re.fullmatch(r"objects/[0-9a-f]{2}/[0-9a-f]{64}/[0-9a-f]{16}/(?:preview|text)/.+", path):
+        return "public, max-age=31536000, immutable"
+    if path.startswith("objects/") and path.rsplit("/", 1)[-1].startswith("document."):
+        return "public, max-age=31536000, immutable"
+    if "/ebook-chapters/" in path:
+        return "public, max-age=31536000, immutable"
+    return "public, max-age=3600"
+
+
+def reader_bucket_for_path(path: str) -> str:
+    if path.startswith(("documents/", "chapters/", "media/", "pages/image/", "native/")):
+        return "vomebook/reader-assets-v2"
+    return "vomebook/pdf-pages-v2"
diff --git a/backend/reader_compression.py b/backend/reader_compression.py
new file mode 100644
index 0000000..652e131
--- /dev/null
+++ b/backend/reader_compression.py
@@ -0,0 +1,30 @@
+"""Decide whether a complete Reader body may negotiate compression."""
+from __future__ import annotations
+
+from collections.abc import Callable, Container, Iterable
+from typing import Protocol
+from urllib.parse import ParseResult
+
+
+class ReaderRequest(Protocol):
+    @property
+    def method(self) -> str: ...
+
+    @property
+    def headers(self) -> Container[str]: ...
+
+
+def reader_body_allows_compression(
+        target_url: str, request: ReaderRequest | None, status: int,
+        get_unquote: Callable[[], Callable[[str], str]],
+        get_urlparse: Callable[[], Callable[[str], ParseResult]],
+        get_suffixes: Callable[[], Container[str]],
+        get_any: Callable[[], Callable[[Iterable[bool]], bool]]) -> bool:
+    """Keep byte-sensitive requests uncompressed and resolve caller state lazily."""
+    if status != 200 or (request is not None and request.method != "GET"):
+        return False
+    headers: Container[str] = request.headers if request is not None else {}
+    if get_any()(name in headers for name in ("Range", "If-Range", "If-None-Match", "If-Modified-Since")):
+        return False
+    path = get_unquote()(get_urlparse()(target_url).path)
+    return path.rsplit(".", 1)[-1].lower() in get_suffixes()
