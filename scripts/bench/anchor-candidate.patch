@@ -0,0 +1,54 @@
+"""Find an anchor in caller-owned ordered search indices with bounded memoization."""
+from __future__ import annotations
+
+from collections import OrderedDict
+from collections.abc import Callable, Iterator, Sequence
+from typing import Protocol
+import weakref
+
+
+class SearchOrder(Protocol):
+    def __iter__(self) -> Iterator[int]: ...
+
+
+def find_search_anchor(indices: SearchOrder, anchor_id: str,
+                       get_cache: Callable[[], OrderedDict[int, tuple[weakref.ReferenceType[SearchOrder], OrderedDict[str, int]]]],
+                       get_records: Callable[[], Sequence[dict[str, object]]],
+                       get_path: Callable[[], Callable[[dict[str, object]], str]],
+                       get_key_limit: Callable[[], int], get_per_order_limit: Callable[[], int],
+                       get_order_limit: Callable[[], int]) -> int:
+    """Preserve weak order ownership, bounded LRUs and caller lookup timing."""
+    owner = id(indices)
+    cached = get_cache().get(owner)
+    if cached is not None and cached[0]() is not indices:
+        del get_cache()[owner]
+        cached = None
+    if cached is not None and anchor_id in cached[1]:
+        cached[1].move_to_end(anchor_id)
+        get_cache().move_to_end(owner)
+        return cached[1][anchor_id]
+    anchor_repo, separator, anchor_path = anchor_id.partition('\0')
+    index = -1
+    if separator:
+        for offset, idx in enumerate(indices):
+            rec = get_records()[idx]
+            repo = str(rec.get('Repo', ''))
+            if repo == anchor_repo:
+                matches = get_path()(rec) == anchor_path
+            elif '\0' in repo and anchor_id.startswith(f'{repo}\0'):
+                matches = f'{repo}\0{get_path()(rec)}' == anchor_id
+            else:
+                continue
+            if matches:
+                index = offset
+                break
+    if len(anchor_id) <= get_key_limit():
+        lookups: OrderedDict[str, int] = cached[1] if cached is not None else OrderedDict()
+        lookups[anchor_id] = index
+        while len(lookups) > get_per_order_limit():
+            lookups.popitem(last=False)
+        get_cache()[owner] = (weakref.ref(indices), lookups)
+        get_cache().move_to_end(owner)
+        while len(get_cache()) > get_order_limit():
+            get_cache().popitem(last=False)
+    return index
