diff --git a/backend/search_candidates.py b/backend/search_candidates.py
new file mode 100644
index 0000000..4ec7f41
--- /dev/null
+++ b/backend/search_candidates.py
@@ -0,0 +1,53 @@
+"""Typed literal n-gram candidate selection over caller-owned search state."""
+from __future__ import annotations
+
+from collections.abc import Callable, Iterable, Mapping, Sequence
+from backend.search_indexes import Posting, PostingIndex
+
+PostingResolver = Callable[[Posting, bytes], set[int]]
+
+
+def literal_candidates(query: str, repos: Iterable[str] | None,
+                       get_postings: Callable[[], Mapping[int, PostingIndex]],
+                       get_buffers: Callable[[], Mapping[int, bytes]],
+                       get_repos: Callable[[], Mapping[str, Sequence[int]]],
+                       get_records: Callable[[], Sequence[dict[str, object]]],
+                       get_resolver: Callable[[], PostingResolver]) -> set[int] | None:
+    """Return an exact posting intersection, or None when no index is usable.
+
+    Index records, repository lists and published postings remain caller-owned.
+    The first decoded posting is owned by the resolver and may be narrowed in
+    place exactly as before; no state is cached or published by this helper.
+    """
+    width = 3 if len(query) >= 3 and get_postings().get(3) else 2
+    postings = get_postings().get(width)
+    if not postings or len(query) < width:
+        return None
+    entries: list[Posting] = []
+    for gram in dict.fromkeys(query[index:index + width] for index in range(len(query) - width + 1)):
+        encoded = postings.get(gram)
+        if encoded is None:
+            return set()
+        entries.append(encoded)
+    entries.sort(key=lambda entry: entry[2] if isinstance(entry, tuple) else len(entry))
+    candidates: set[int] | None = None
+    repo_scope = set(repos) if repos else None
+    for encoded in entries:
+        matches = get_resolver()(encoded, get_buffers().get(width, b""))
+        if candidates is None:
+            candidates = matches
+            if repo_scope is not None:
+                if len(candidates) <= 2048 and sum(
+                        len(get_repos().get(repo, ())) for repo in repo_scope) > len(candidates) * 8:
+                    candidates = {idx for idx in candidates if 0 <= idx < len(get_records())
+                                  and get_records()[idx].get("Repo", "") in repo_scope}
+                else:
+                    allowed: set[int] = set()
+                    for repo in repo_scope:
+                        allowed.update(get_repos().get(repo, []))
+                    candidates.intersection_update(allowed)
+        else:
+            candidates.intersection_update(matches)
+        if not candidates:
+            return set()
+    return candidates or set()
